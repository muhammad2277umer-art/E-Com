# Neon: use the pooled connection string (host contains "-pooler") for DATABASE_URL
# and the direct one (same host without "-pooler") for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Long random string. Encrypts saved mailbox passwords, so don't change it after adding mailboxes.
APP_SECRET="replace-with-a-long-random-string"

# Team password for signing in. Leave empty to turn the login off (local only).
APP_PASSWORD="choose-a-password"

# Protects the scheduled mailbox sync endpoint.
CRON_SECRET="replace-with-another-random-string"

# Optional: lets Claude write personalised drafts. Without it, built-in templates are used.
ANTHROPIC_API_KEY=""
